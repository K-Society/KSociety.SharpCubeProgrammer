        <DebugResetMode>
            <summary>
                Choose the way to apply a system reset.
                <list type="table">
                    <item>
                        <term>SoftwareReset (0)</term>
                        <description>Apply a reset by the software.</description>
                    </item>
                    <item>
                        <term>HardwareReset (1)</term>
                        <description>Apply a reset by the hardware.</description>
                    </item>
                    <item>
                        <term>CoreReset (2)</term>
