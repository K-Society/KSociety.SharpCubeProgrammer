                    </item>
                    <item>
                        <term>Change Freq (-15)</term>
                        <description>Changing frequency problem.</description>
                    </item>
                    <item>
                        <term>Rdp Enabled (-16)</term>
                        <description>RDP Enabled error.</description>
                    </item>
                    <item>
                        <term>Other Error (-99)</term>
                        <description>Other error.</description>
                    </item>
                </list>
