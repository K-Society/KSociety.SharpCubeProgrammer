<docs>
    <members name="i2cConnectParameters">
        <I2cConnectParameters>
            <summary>
                Specify the I2C connect parameters.
                <list type="table">
                    <item>
                        <term>Address</term>
                        <description>Device address in hex format.</description>
                    </item>
                    <item>
                        <term>Baudrate</term>
                        <description>Baudrate and speed transmission : 100 or 400 KHz.</description>
                    </item>
                    <item>
                        <term>SpeedMode</term>
                        <description>Speed Mode: STANDARD or FAST.</description>
                    </item>
                    <item>
                        <term>AddressMode</term>
                        <description>Address Mode: 7 or 10 bits.</description>
                    </item>
                    <item>
                        <term>AnalogFilter</term>
                        <description>Analog filter: DISABLE or ENABLE.</description>
                    </item>
                    <item>
                        <term>DigitalFilter</term>
                        <description>Digital filter: DISABLE or ENABLE.</description>
                    </item>
                    <item>
                        <term>DigitalNoiseFilter</term>
                        <description>Digital noise filter: 0 to 15.</description>
                    </item>
                    <item>
                        <term>RiseTime</term>
                        <description>Rise time: 0-1000 for STANDARD speed mode and  0-300 for FAST.</description>
                    </item>
                    <item>
                        <term>FallTime</term>
                        <description>Fall time: 0-300 for STANDARD speed mode and  0-300 for FAST.</description>
                    </item>
                </list>
            </summary>
            <remarks>
                <para>
                    The Bootloader Slave address varies depending on the device (see AN2606).
                </para>
                <para>
                    Not all configurations are supported by STM32 Bootloader, such as address in 7 bits form, analog filter: ENABLE, digital filter: DISABLE.
                </para>
                <para>
                    Recommended I2C parameters : Address=0x??, Baudrate=400, SpeedMode=1, AddressMode=0, AnalogFilter=1, DigitalFilter=0, DigitalNoiseFilter=0, RiseTime=0, FallTime=0
                </para>
            </remarks>
        </I2cConnectParameters>

