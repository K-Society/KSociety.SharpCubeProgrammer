<docs>
    <members name="usartConnectParameters">
        <UsartConnectParameters>
            <summary>
                USART connect parameters.
                <list type="table">
                    <item>
                        <term>PortName</term>
                        <description>Interface identifier: COM1, COM2, /dev/ttyS0...</description>
                    </item>
                    <item>
                        <term>Baudrate</term>
                        <description>Speed transmission: 115200, 9600...</description>
                    </item>
                    <item>
                        <term>Parity</term>
                        <description>Parity bit: value in UsartParity.</description>
                    </item>
                    <item>
                        <term>DataBits</term>
                        <description>Data bit: value in {6, 7, 8}.</description>
                    </item>
                    <item>
                        <term>StopBits</term>
                        <description>Stop bit: value in {1, 1.5, 2}.</description>
                    </item>
                    <item>
                        <term>FlowControl</term>
                        <description>Flow control: value in UsartFlowControl.</description>
                    </item>
                    <item>
                        <term>StatusRTS</term>
                        <description>RTS status: value in {0,1}.</description>
                    </item>
                    <item>
                        <term>StatusDTR</term>
                        <description>DTR status: value in {0,1}.</description>
                    </item>
                    <item>
                        <term>DelayRtsDtr</term>
                        <description>Delay between RTS and DTR.</description>
                    </item>
                    <item>
                        <term>NoInitBits</term>
                        <description>Set No Init bits: value in {0,1}.</description>
                    </item>
                    <item>
                        <term>RequestReadUnprotect</term>
                        <description>Request a read unprotect: value in {0,1}.</description>
                    </item>
                    <item>
                        <term>Tzenreg</term>
                        <description>Request a TZEN regression: value in {0,1}.</description>
                    </item>
                </list>
            </summary>
        </UsartConnectParameters>

