            </summary>
        </CanType>

        <FrameFormat>
            <summary>
                Frame format: DATA or REMOTE.
            </summary>
        </FrameFormat>

        <Fifo>
            <summary>
                Memory of received messages: FIFO0 or FIFO1.
            </summary>
        </Fifo>

        <FilterMode>
            <summary>
                Filter mode: MASK or LIST.
            </summary>
        </FilterMode>

        <FilterScale>
            <summary>
                Filter scale: 16 or 32.
            </summary>
        </FilterScale>

        <FilterActivation>
            <summary>
                Filter activation: DISABLE or ENABLE.
            </summary>
        </FilterActivation>

        <FilterBankNumber>
            <summary>
                Filter bank number: 0 to 13.
            </summary>
        </FilterBankNumber>
    </members>
